# Rename this file to `.env` and fill in these required values.

# Database connection (local dev can use 127.0.0.1, Docker uses 'db')
# For a web-only Docker deployment, set DB_ENABLED=false and leave DB_HOST empty.
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=solacecore

# Minecraft plugin WebSocket connection
# Must match your Minecraft plugin websocket-port (default: 8081)
# Set ENABLE_MINECRAFT_WS=false if you don't have the plugin installed
ENABLE_MINECRAFT_WS=true
WS_HOST=127.0.0.1
WS_PORT=8081

# JWT secret for moderator authentication
# IMPORTANT: Generate a secure random 64-character string!
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-string-64-characters-long
